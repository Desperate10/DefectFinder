<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DefectActivity">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/activity_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/defect_info"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline3"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/defect_group"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/spinner_bg"
                android:padding="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center|left"
                android:text="Виберіть групу дефектів" />

            <TextView
                android:id="@+id/defect_subgroup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/spinner_bg"
                android:padding="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center|left"
                android:text="Виберіть підгрупу дефектів"
                android:visibility="gone" />

            <TextView
                android:id="@+id/searchableSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/spinner_bg"
                android:padding="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center|left"
                android:text="Виберіть дефект" />

            <LinearLayout
                android:id="@+id/thermal_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp">

                <CheckBox
                    android:id="@+id/cb_thermal_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/thermal_done_ok"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cb_thermal_not_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/thermal_not_done"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/defects_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="24dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/cb_defects_found"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/defects_found" />

                    <CheckBox
                        android:id="@+id/cb_defects_absent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/defects_absent" />
                </LinearLayout>
            </LinearLayout>

            <GridView
                android:id="@+id/photo_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:horizontalSpacing="5dp"
                android:numColumns="3"
                android:stretchMode="columnWidth"
                android:verticalSpacing="5dp" />

            <EditText
                android:id="@+id/adds"
                android:inputType="textMultiLine"
                android:lines="4"
                android:minLines="4"
                android:maxLines="5"
                android:gravity="top|left"
                android:hint="@string/note"
                android:background="@drawable/edit_text_border"
                android:layout_margin="16dp"
                android:padding="16dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:scrollbars="vertical" />

            <Button
                android:id="@+id/continue_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/go_continue" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
